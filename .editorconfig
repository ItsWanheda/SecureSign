# ============================================================

# SecureSign — EditorConfig

# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.{html,css,js,json}]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.svg]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
